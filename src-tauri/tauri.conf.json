{
  "productName": "Zecho",
  "version": "0.1.0",
  "identifier": "com.dzearing.zecho",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "pill",
        "title": "Zecho",
        "width": 340,
        "height": 460,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "visible": true
      },
      {
        "label": "setup",
        "title": "Welcome to Zecho",
        "url": "setup.html",
        "width": 520,
        "height": 560,
        "decorations": true,
        "resizable": false,
        "visible": false,
        "center": true
      },
      {
        "label": "settings",
        "title": "Zecho Settings",
        "url": "settings.html",
        "width": 720,
        "height": 780,
        "decorations": true,
        "resizable": false,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/32x32.png"
    ],
    "resources": [],
    "macOS": {
      "signingIdentity": "Developer ID Application: DAVID BENJAMIN ZEARING (VMGW2V57S7)"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/dzearing/zecho/releases/latest/download/latest.json"
      ],
      "pubkey": ""
    }
  }
}
